# Admin Backend credentials (HTTP Basic Auth)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Encryption key for sensitive config values (API keys) stored in DB.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset: sensitive values stored plaintext (development mode).
CONFIG_SECRET=

# Optional: restrict CORS origins (comma-separated, default: *)
# ADMIN_CORS_ORIGINS=https://admin.example.com

# Optional: override database path (default: db/profile.db)
# MEMCP_DB_PATH=db/profile.db
